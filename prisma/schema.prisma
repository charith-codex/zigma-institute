generator client {
  provider = "prisma-client-js"  // -js added after prisma 6.0 only came with client
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  coverImage  String
  description String
  teacherName   String


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
